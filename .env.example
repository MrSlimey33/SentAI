# Anthropic API Key (get one free at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Your name (how the AI will address you)
USER_NAME=Friend

# AI name (her name)
AI_NAME=Aria

# Optional: Discord webhook URL for text notifications (leave blank to use terminal only)
DISCORD_WEBHOOK_URL=

# Optional: Timezone (default: America/New_York)
TIMEZONE=America/New_York
